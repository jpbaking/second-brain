#!/usr/bin/env python3
"""Vault PreToolUse hook — enforces "originals are sacred": blocks file-write
tools targeting library/ (everything except catalog.md). Library files may
only be moved/renamed, never edited; that is done via execute_command, which
this hook deliberately does not police (mv is legitimate).
Fail-open: any error returns {"cancel": false}."""

import json
import re
import sys

WRITE_TOOLS = {"write_to_file", "replace_in_file", "apply_diff", "edit_file"}


def get_tool(data):
    for key in ("toolName", "tool", "tool_name", "name"):
        v = data.get(key)
        if isinstance(v, str):
            return v
    return ""


def get_params(data):
    for key in ("toolParameters", "parameters", "toolInput", "params", "input"):
        v = data.get(key)
        if isinstance(v, dict):
            return v
    return {}


def main():
    try:
        data = json.load(sys.stdin)
        tool = get_tool(data)
        params = get_params(data)
        path = str(params.get("path") or params.get("file_path") or "")
        norm = re.sub(r"^\./", "", path.replace("\\", "/"))
        if (
            tool in WRITE_TOOLS
            and re.match(r"^(.*/)?library/", norm)
            and not norm.endswith("catalog.md")
        ):
            json.dump(
                {
                    "cancel": True,
                    "errorMessage": (
                        "Blocked by vault hook: files under library/ are "
                        "originals and must never be edited (prime directive 1 "
                        "in .clinerules/00-role.md). Move/rename with a shell "
                        "command if filing; put summaries and corrections in "
                        "memory/ instead. If the principal explicitly wants an "
                        "original changed, ask them to confirm in chat and "
                        "edit a COPY placed outside library/."
                    ),
                },
                sys.stdout,
            )
            return
    except Exception:
        pass
    json.dump({"cancel": False}, sys.stdout)


if __name__ == "__main__":
    main()
