#!/usr/bin/env python3
"""Vault PreToolUse hook — enforces "originals are sacred".

Blocks direct file writes and obvious mutating shell commands targeting
library originals. Shell inspection is deliberately conservative and is a
guardrail, not a security boundary; scripts/validate_commit.py is the final
staged-change check.
Fail-open: any error returns {"cancel": false}."""

import json
import re
import sys

WRITE_TOOLS = {"write_to_file", "replace_in_file", "apply_diff", "edit_file"}
SHELL_TOOLS = {"execute_command", "exec_command", "run_command"}
MUTATING_SHELL_RE = re.compile(
    r"(?:^|[;&|]\s*)(?:rm|cp|sed|perl|python\d*|truncate|dd|touch|chmod|chown)\b"
    r"|(?:>|>>)\s*[^;&|]*library[/\\]",
    re.IGNORECASE,
)


def get_tool(data):
    for key in ("toolName", "tool", "tool_name", "name"):
        v = data.get(key)
        if isinstance(v, str):
            return v
    return ""


def get_params(data):
    for key in ("toolParameters", "parameters", "toolInput", "params", "input"):
        v = data.get(key)
        if isinstance(v, dict):
            return v
    return {}


def is_library_original(path):
    norm = re.sub(r"^\./", "", path.replace("\\", "/"))
    return bool(re.match(r"^(.*/)?library/", norm)) and not norm.endswith("catalog.md")


def blocked_shell(command):
    """Catch common destructive writes; allow mv because filing uses it."""
    if not re.search(r"(?:^|[\s'\"])(?:\./)?library[/\\]", command):
        return False
    return bool(MUTATING_SHELL_RE.search(command))


def main():
    try:
        data = json.load(sys.stdin)
        tool = get_tool(data)
        params = get_params(data)
        path = str(params.get("path") or params.get("file_path") or "")
        command = str(params.get("command") or params.get("cmd") or "")
        if (tool in WRITE_TOOLS and is_library_original(path)) or (
            tool in SHELL_TOOLS and blocked_shell(command)
        ):
            json.dump(
                {
                    "cancel": True,
                    "errorMessage": (
                        "Blocked by vault hook: files under library/ are "
                        "originals and must never be edited (prime directive 1 "
                        "in rules/shared/00-role.md). Move/rename with a shell "
                        "command if filing; put summaries and corrections in "
                        "memory/ instead. Moving/renaming originals remains "
                        "allowed. If the principal explicitly wants an "
                        "original changed, ask them to confirm in chat and "
                        "edit a COPY placed outside library/."
                    ),
                },
                sys.stdout,
            )
            return
    except Exception:
        pass
    json.dump({"cancel": False}, sys.stdout)


if __name__ == "__main__":
    main()
